# Model backend configuration for tiny-multiagent-go.
# Copy this file to ".env" and fill in your values.

# Protocol: "openai" (any OpenAI-compatible server) or "anthropic"
PROTOCOL=openai

# API base URL, e.g.
#   https://api.openai.com/v1
#   https://api.anthropic.com/v1
#   or any self-hosted OpenAI-compatible server
BASE_URL=https://api.openai.com/v1

# API key (Bearer token for openai, x-api-key for anthropic)
API_KEY=sk-your-key

# Model name, e.g. gpt-4o-mini, claude-sonnet-4-5
MODEL=gpt-4o-mini
